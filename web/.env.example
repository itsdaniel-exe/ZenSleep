# Leave unset for the default (relative "/api/..." requests against whatever
# origin served the page - correct in production and under `wrangler dev`).
# Only needed when running this Vite dev server (HMR, :5173) separately
# against `wrangler dev`'s API (:8787) - those are different origins.
# Vite bakes this in at build time, not runtime - changing it requires a rebuild.
VITE_API_URL=http://localhost:8787

# Optional: wire a real Firebase project for auth/storage later.
# Leave all blank to stay in local demo-user mode (default) — see src/firebase.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
