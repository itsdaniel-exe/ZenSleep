# Base URL of the ZenSleep backend API (see ../backend)
VITE_API_URL=http://localhost:4790

# Optional: wire a real Firebase project for auth/storage later.
# Leave all blank to stay in local demo-user mode (default) — see src/firebase.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
