{
  "name": "zensleep-backend",
  "version": "0.1.0",
  "description": "ZenSleep API: ingest wearable sleep signals, compute sleep score and stress inference, serve dashboard data. Deployed as a Cloudflare Worker.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "db:migrate:local": "wrangler d1 migrations apply zensleep-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply zensleep-db --remote"
  },
  "dependencies": {
    "hono": "^4.6.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "eslint": "^9.9.1",
    "globals": "^15.9.0",
    "wrangler": "^4.20.0"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
