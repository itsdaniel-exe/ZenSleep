# Port the API listens on
PORT=4790

# Optional: enable real AI-generated narrative insights instead of the
# built-in template-based fallback. Get a key from https://console.anthropic.com
# Leave unset to run fully offline with no external calls.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Comma-separated origins allowed to call this API (web dashboard dev server).
# Set to * to allow any origin (fine for this app - no auth/user data to protect).
CORS_ORIGIN=http://localhost:5173
